{
  "name": "@minimal-agent/plugin-api",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Leaf contract package for minimal-agent: provider-neutral types and pure utilities shared by the host (src/) and plugins. Imports NOTHING from src/ or plugins/.",
  "homepage": "https://github.com/gastonmorixe/minimal-agent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gastonmorixe/minimal-agent.git"
  },
  "exports": {
    ".": "./src/index.ts",
    "./utils/agent-paths": "./src/utils/agent-paths.ts",
    "./utils/term-width": "./src/utils/term-width.ts",
    "./utils/jsonc": "./src/utils/jsonc.ts",
    "./utils/palette": "./src/utils/palette.ts",
    "./utils/ansi": "./src/utils/ansi.ts",
    "./utils/shell-args": "./src/utils/shell-args.ts",
    "./utils/mode-style": "./src/utils/mode-style.ts",
    "./utils/usage-report": "./src/utils/usage-report.ts",
    "./utils/usage-render": "./src/utils/usage-render.ts",
    "./utils/sse-parser": "./src/utils/sse-parser.ts",
    "./utils/unified-diff": "./src/utils/unified-diff.ts",
    "./utils/bounded-drain": "./src/utils/bounded-drain.ts",
    "./utils/decoration-suffix": "./src/utils/decoration-suffix.ts",
    "./utils/platform": "./src/utils/platform.ts",
    "./types/plugin": "./src/types/plugin.ts",
    "./types/host-capabilities": "./src/types/host-capabilities.ts",
    "./net/types": "./src/net/types.ts",
    "./llm/capabilities": "./src/llm/capabilities.ts",
    "./llm/errors": "./src/llm/errors.ts",
    "./llm/token-estimate": "./src/llm/token-estimate.ts",
    "./llm/modality-check": "./src/llm/modality-check.ts",
    "./llm/canonical-events": "./src/llm/canonical-events.ts",
    "./llm/canonical-request": "./src/llm/canonical-request.ts",
    "./llm/canonical-messages": "./src/llm/canonical-messages.ts",
    "./llm/canonical-tools": "./src/llm/canonical-tools.ts",
    "./llm/provider-auth": "./src/llm/provider-auth.ts",
    "./llm/provider-plugin": "./src/llm/provider-plugin.ts"
  }
}
