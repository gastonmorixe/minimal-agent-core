{
  "name": "minimal-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "plugin-api",
    "tools/docs"
  ],
  "description": "A tiny, beautiful, composable terminal agent harness that runs straight from source on Bun.",
  "homepage": "https://github.com/gastonmorixe/minimal-agent-core",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gastonmorixe/minimal-agent-core.git"
  },
  "bin": {
    "minimal-agent": "src/index.ts"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "dependencies": {
    "@minimal-agent/plugin-api": "workspace:*"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "test:arch": "bun test src/architecture",
    "test:e2e": "E2E=1 bun test",
    "typecheck": "bun run scripts/typecheck.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "imports": "biome check --write --formatter-enabled=false --linter-enabled=false .",
    "docs:check": "tools/docs/node_modules/.bin/typedoc --options typedoc.json",
    "check": "bun run scripts/check.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "bun-types": "^1.3.14",
    "eslint-plugin-jsdoc": "^63.0.12",
    "eslint-plugin-tsdoc": "^0.5.2",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.6"
  },
  "license": "UNLICENSED"
}
