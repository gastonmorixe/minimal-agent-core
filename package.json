{
  "name": "@minimal-agent/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "A tiny, beautiful, composable agent engine that runs straight from source on Bun.",
  "homepage": "https://github.com/gastonmorixe/minimal-agent-core",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gastonmorixe/minimal-agent-core.git"
  },
  "bin": {
    "minimal-agent": "src/index.ts"
  },
  "exports": {
    ".": "./src/sdk/runtime.ts",
    "./sdk/events": "./src/sdk/events.ts",
    "./sdk/lifecycle": "./src/sdk/lifecycle.ts",
    "./sdk/ports": "./src/sdk/ports.ts",
    "./sdk/agent-core": "./src/sdk/agent-core.ts",
    "./plugin-api": "./plugin-api/src/index.ts",
    "./plugin-api/utils/agent-paths": "./plugin-api/src/utils/agent-paths.ts",
    "./plugin-api/utils/term-width": "./plugin-api/src/utils/term-width.ts",
    "./plugin-api/utils/jsonc": "./plugin-api/src/utils/jsonc.ts",
    "./plugin-api/utils/palette": "./plugin-api/src/utils/palette.ts",
    "./plugin-api/utils/ansi": "./plugin-api/src/utils/ansi.ts",
    "./plugin-api/utils/shell-args": "./plugin-api/src/utils/shell-args.ts",
    "./plugin-api/utils/file-lock": "./plugin-api/src/utils/file-lock.ts",
    "./plugin-api/utils/retry": "./plugin-api/src/utils/retry.ts",
    "./plugin-api/utils/usage-report": "./plugin-api/src/utils/usage-report.ts",
    "./plugin-api/utils/sse-parser": "./plugin-api/src/utils/sse-parser.ts",
    "./plugin-api/utils/unified-diff": "./plugin-api/src/utils/unified-diff.ts",
    "./plugin-api/utils/bounded-drain": "./plugin-api/src/utils/bounded-drain.ts",
    "./plugin-api/utils/platform": "./plugin-api/src/utils/platform.ts",
    "./plugin-api/types/plugin": "./plugin-api/src/types/plugin.ts",
    "./plugin-api/types/host-capabilities": "./plugin-api/src/types/host-capabilities.ts",
    "./plugin-api/net/types": "./plugin-api/src/net/types.ts",
    "./plugin-api/llm/capabilities": "./plugin-api/src/llm/capabilities.ts",
    "./plugin-api/llm/errors": "./plugin-api/src/llm/errors.ts",
    "./plugin-api/llm/token-estimate": "./plugin-api/src/llm/token-estimate.ts",
    "./plugin-api/llm/modality-check": "./plugin-api/src/llm/modality-check.ts",
    "./plugin-api/llm/canonical-events": "./plugin-api/src/llm/canonical-events.ts",
    "./plugin-api/llm/openai-chat": "./plugin-api/src/llm/openai-chat.ts",
    "./plugin-api/llm/anthropic-stream": "./plugin-api/src/llm/anthropic-stream.ts",
    "./plugin-api/llm/anthropic-request": "./plugin-api/src/llm/anthropic-request.ts",
    "./plugin-api/llm/canonical-request": "./plugin-api/src/llm/canonical-request.ts",
    "./plugin-api/llm/canonical-messages": "./plugin-api/src/llm/canonical-messages.ts",
    "./plugin-api/llm/canonical-tools": "./plugin-api/src/llm/canonical-tools.ts",
    "./plugin-api/llm/provider-auth": "./plugin-api/src/llm/provider-auth.ts",
    "./plugin-api/llm/provider-plugin": "./plugin-api/src/llm/provider-plugin.ts",
    "./plugin-api/llm/surface-codec": "./plugin-api/src/llm/surface-codec.ts",
    "./package.json": "./package.json"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "workspaces": {
    "packages": [
      "tools/docs"
    ],
    "catalog": {
      "@biomejs/biome": "^2.5.15",
      "bun-types": "^1.4.3",
      "eslint-plugin-jsdoc": "^63.3.3",
      "eslint-plugin-tsdoc": "^0.5.4",
      "oxlint": "^1.88.0",
      "oxlint-tsgolint": "^7.0.2004",
      "typescript": "^7.0.2"
    }
  },
  "dependencies": {},
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "test:arch": "bun test src/architecture",
    "test:e2e": "E2E=1 bun test",
    "typecheck": "bun run scripts/typecheck.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "imports": "biome check --write --formatter-enabled=false --linter-enabled=false .",
    "docs:check": "tools/docs/node_modules/.bin/typedoc --options typedoc.json",
    "check": "bun run scripts/check.ts",
    "workspaces:list": "bun pm ls --all",
    "prepare": "husky",
    "commitlint": "commitlint",
    "commitlint:last": "commitlint --last --verbose"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "bun-types": "catalog:",
    "eslint-plugin-jsdoc": "catalog:",
    "eslint-plugin-tsdoc": "catalog:",
    "husky": "^9.1.7",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  },
  "overrides": {
    "brace-expansion": "^5.0.6"
  }
}
