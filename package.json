{
  "name": "minimal-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "test:e2e": "E2E=1 bun test",
    "typecheck": "bun run scripts/typecheck.ts",
    "typecheck:fast": "tsgo --noEmit",
    "typecheck:fallback": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "imports": "biome check --write --formatter-enabled=false --linter-enabled=false .",
    "docs:check": "typedoc --options typedoc.json",
    "check": "bun run scripts/check.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@typescript/native-preview": "beta",
    "bun-types": "^1.3.11",
    "eslint-plugin-jsdoc": "^62.9.0",
    "oxlint": "^1.61.0",
    "oxlint-tsgolint": "^0.22.0",
    "typedoc": "^0.28.0",
    "typescript": "^6.0.3"
  }
}
