{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "import"],
  "jsPlugins": [
    {
      "name": "jsdoc-js",
      "specifier": "eslint-plugin-jsdoc"
    },
    {
      "name": "tsdoc",
      "specifier": "eslint-plugin-tsdoc"
    }
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "warn"
  },
  "settings": {
    "jsdoc": {
      "ignorePrivate": true,
      "ignoreInternal": true
    }
  },
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/await-thenable": "off",
    "typescript/no-base-to-string": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/no-unnecessary-type-assertion": "off",
    "typescript/no-unnecessary-boolean-literal-compare": "off",
    "typescript/restrict-template-expressions": "off",
    "typescript/require-array-sort-compare": "off",
    "no-await-in-loop": "off",
    "no-control-regex": "off",
    "no-shadow": "off",
    "no-underscore-dangle": "off",
    "no-unmodified-loop-condition": "off",
    // Doc enforcement split (see private/linting-formatting-improvement/research/
    // tsdoc-vs-jsdoc.md): jsdoc-js owns PRESENCE (a doc comment exists, has a
    // description, param names match); tsdoc/syntax owns SYNTAX (valid TSDoc per
    // the repo tsdoc.json). check-tag-names is dropped on both jsdoc plugins:
    // its JSDoc tag list fights TSDoc vocabulary (@remarks, @typeParam, ...).
    "tsdoc/syntax": "error",
    "jsdoc-js/require-jsdoc": [
      "error",
      {
        "publicOnly": true,
        "require": {
          "ArrowFunctionExpression": false,
          "ClassDeclaration": true,
          "ClassExpression": true,
          "FunctionDeclaration": true,
          "FunctionExpression": false,
          "MethodDefinition": true
        }
      }
    ],
    "jsdoc-js/require-description": "error",
    "jsdoc-js/check-param-names": "error",
    "jsdoc-js/require-param": "off",
    "jsdoc-js/require-param-description": "off",
    "jsdoc-js/require-returns": "off",
    "jsdoc-js/require-returns-description": "off",
    // Bug #195n3: 800 is a hard ERROR with NO exemptions (tests included).
    // A file that can't fit in 800 meaningful lines needs decoupling, not
    // an override entry.
    "max-lines": ["error", { "max": 810, "skipBlankLines": true, "skipComments": true }]
  },
  "overrides": [
    {
      // Tests + scaffolding: PRESENCE rules off (documenting every it()
      // helper is noise). tsdoc/syntax and max-lines stay ON everywhere.
      "files": ["**/*.test.ts", "src/test-utils.ts", "src/spinner/library/**"],
      "rules": {
        "jsdoc-js/require-jsdoc": "off",
        "jsdoc-js/require-description": "off",
        "jsdoc-js/check-param-names": "off"
      }
    },
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "require-yield": "off"
      }
    },
    {
      "files": ["src/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../plugins/**"],
                "message": "I2: core (src/) must not import the top-level plugins/ tree. Route through a core-owned seam (loader discovery, registration hook, ctx/host capability). See src/architecture.core-plugin-imports.test.ts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/*/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../../plugins/**"],
                "message": "I2: core (src/) must not import the top-level plugins/ tree. Route through a core-owned seam (loader discovery, registration hook, ctx/host capability). See src/architecture.core-plugin-imports.test.ts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/*/*/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../../../plugins/**"],
                "message": "I2: core (src/) must not import the top-level plugins/ tree. Route through a core-owned seam (loader discovery, registration hook, ctx/host capability). See src/architecture.core-plugin-imports.test.ts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/*/*/*/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../../../../plugins/**"],
                "message": "I2: core (src/) must not import the top-level plugins/ tree. Route through a core-owned seam (loader discovery, registration hook, ctx/host capability). See src/architecture.core-plugin-imports.test.ts."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/**",
    "docs/**",
    "private/**",
    "research/**",
    "work/**",
    ".swarm/**",
    "tmp/**"
  ]
}
