#!/usr/bin/env bash
# Resolve this file even when invoked through a PATH symlink
# (`~/.minimal-agent/bin/minimal-agent` -> <checkout>/minimal-agent).
SOURCE="${BASH_SOURCE[0]:-$0}"
if [ -L "$SOURCE" ]; then
  TARGET="$(readlink "$SOURCE")"
  case "$TARGET" in
    /*) SOURCE="$TARGET" ;;
    *) SOURCE="$(cd "$(dirname "$SOURCE")" && pwd)/$TARGET" ;;
  esac
fi
DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
exec bun run "$DIR/src/index.ts" "$@"
